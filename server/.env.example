# ADARE GENERAL HOSPITAL PLATFORM — environment template
# Copy to .env and fill in real values. NEVER commit real credentials.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgres://agh:CHANGE-ME@127.0.0.1:5432/adare_platform

JWT_SECRET=CHANGE-ME-64-RANDOM-CHARS
REFRESH_TOKEN_SECRET=CHANGE-ME-64-RANDOM-CHARS
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
SECURE_COOKIES=1

LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_BYTES=5242880

# Email (empty = disabled, nothing simulated)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# SMS provider (approved Ethiopian provider; empty = disabled)
SMS_PROVIDER=
SMS_API_KEY=

# Payment provider (Telebirr etc.; empty = manual verification workflow only)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# Object storage (S3-compatible; empty = local storage/)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

MAPS_API_KEY=
