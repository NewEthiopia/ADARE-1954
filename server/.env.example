# ADARE GENERAL HOSPITAL PLATFORM — environment template
# Copy to .env and fill in real values. NEVER commit real credentials.

NODE_ENV=production
PORT=4000

DATABASE_URL=postgres://agh:CHANGE-ME@127.0.0.1:5432/adare_platform

JWT_SECRET=CHANGE-ME-64-RANDOM-CHARS
REFRESH_TOKEN_SECRET=CHANGE-ME-64-RANDOM-CHARS
ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
SECURE_COOKIES=1

LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
MAX_UPLOAD_BYTES=5242880

# Email (empty = disabled, nothing simulated)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=appointments@adaregeneralhospital.com
SMTP_PASSWORD=
SMTP_FROM=appointments@adaregeneralhospital.com

# Google Gemini API free tier (keep this server-side; never expose in VITE_ variables)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMS provider (approved Ethiopian provider; empty = disabled)
SMS_PROVIDER=
SMS_API_KEY=

# Payment provider (Telebirr etc.; empty = manual verification workflow only)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# DHIS2 aggregate daily reporting (set directly in protected server .env after
# receiving the dataset/org-unit/data-element UIDs; never put access credentials in the frontend)
DHIS2_BASE_URL=https://tbh.ephi.gov.et/api
DHIS2_DATASET_UID=
DHIS2_ORG_UNIT_UID=
DHIS2_DE_VACCINATION_ACTIVITY=
DHIS2_DE_DOSES_ADMINISTERED=
DHIS2_DE_DOSES_WASTED=
DHIS2_DE_ADVERSE_EVENTS=
DHIS2_ACCESS_TOKEN=
# Alternatively use an approved service-account pair instead of an access token:
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Object storage (S3-compatible; empty = local storage/)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

MAPS_API_KEY=
